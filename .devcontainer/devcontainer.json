{
    "name": "zed",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        // Install node.
        "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
        // Install the GitHub CLI.
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "runArgs": [
        // Fixes the hostname so shell prompts and logs identify the container.
        "--hostname", "zed",
        // Passes through the host's GPU render node for hardware Vulkan.
        "--device=/dev/dri:/dev/dri"
    ],

    "mounts": [
        // One volume for the whole container home so all config survive a rebuild.
        "source=zed-home,target=/home/vscode,type=volume",
        // Lets Zed draw on the host's X11 display.
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],

    // Forwards the host's DISPLAY so GUI apps in the container can use it.
    "remoteEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },

    // Keeps cargo's build output off the host-visible bind mount.
    "containerEnv": {
        "CARGO_TARGET_DIR": "/home/vscode/.cache/zed-target"
    },

    // Runs the post-create script to set up the container.
    "postCreateCommand": ".devcontainer/post-create.sh",

    // Connect to the devcontainer as non-root.
    // It allows Claude Code run with --dangerously-skip-permissions.
    "remoteUser": "vscode"
}
